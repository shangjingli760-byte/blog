# 博客后端环境变量配置示例
# 复制此文件为 .env 并修改相应值

# 服务端口
PORT=8080

# 数据库路径
DB_PATH=./data/blog.db

# JWT 密钥（生产环境务必修改为强随机字符串）
JWT_SECRET=your-secret-key-change-in-production

# 管理员账号
ADMIN_USER=admin

# 管理员密码
# 推荐使用 bcrypt 哈希（成本因子 10）
# 生成方法：使用在线工具或运行以下 Go 代码
# import "golang.org/x/crypto/bcrypt"
# hash, _ := bcrypt.GenerateFromPassword([]byte("your-password"), 10)
# 示例：admin123 的 bcrypt 哈希
ADMIN_PASSWORD=$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy

# 注意：也支持明文密码（不推荐，仅用于测试）
# ADMIN_PASSWORD=admin123
